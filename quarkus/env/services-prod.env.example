# Shared runtime
LOG_JSON_ENABLED=true
METRICS_PROMETHEUS_ENABLED=true
DOWNSTREAM_CONNECT_TIMEOUT=1000
DOWNSTREAM_READ_TIMEOUT=3000

# Service ports
GATEWAY_SERVICE_PORT=8080
IMAGE_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
PROFILE_SERVICE_PORT=8085
PROJECT_SERVICE_PORT=8086
EMAIL_SERVICE_PORT=8087
USER_SERVICE_PORT=8088
MANAGER_SERVICE_PORT=8091

# Internal service URLs in Kubernetes or the target runtime
USER_SERVICE_URL=http://user-service:8088
PROFILE_SERVICE_URL=http://profile-service:8085
PROJECT_SERVICE_URL=http://project-service:8086
NOTIFICATION_SERVICE_URL=http://notification-service:8084
MANAGER_SERVICE_URL=http://manager-service:8091
IMAGE_SERVICE_URL=http://image-service:8083
EMAIL_SERVICE_URL=http://email-service:8087

# Gateway
GATEWAY_LOG_LEVEL=INFO
GATEWAY_CORS_ORIGINS=https://your-domain.com
GATEWAY_AUTH_PROTECTED_PREFIXES=/users,/profiles,/project,/manager
GATEWAY_REQUEST_TIMEOUT_MILLIS=10000
GATEWAY_AUTH_TIMEOUT_MILLIS=5000
GATEWAY_MAX_BODY_SIZE=20M

# MySQL shared credentials plus per-service JDBC URLs
MYSQL_USERNAME=change-me-service-user
MYSQL_PASSWORD=change-me
USER_MYSQL_JDBC_URL=jdbc:mysql://mysql-prod-host:3306/user_service?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=false
PROJECT_MYSQL_JDBC_URL=jdbc:mysql://mysql-prod-host:3306/project_service?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=false
NOTIFICATION_MYSQL_JDBC_URL=jdbc:mysql://mysql-prod-host:3306/notification_service?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=false
EMAIL_MYSQL_JDBC_URL=jdbc:mysql://mysql-prod-host:3306/email_service?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=false
IMAGE_MYSQL_JDBC_URL=jdbc:mysql://mysql-prod-host:3306/image_service?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=false
USER_DB_SCHEMA_STRATEGY=validate
PROJECT_DB_GENERATION=validate
NOTIFICATION_DB_GENERATION=validate
EMAIL_DB_SCHEMA_STRATEGY=validate
IMAGE_DB_GENERATION=validate
USER_DB_LOG_SQL=false
PROJECT_DB_LOG_SQL=false
NOTIFICATION_DB_LOG_SQL=false
EMAIL_DB_LOG_SQL=false
IMAGE_DB_LOG_SQL=false
USER_DB_MIGRATE=true
USER_DB_BASELINE_ON_MIGRATE=false
EMAIL_DB_MIGRATE=true
EMAIL_DB_BASELINE_ON_MIGRATE=false

# MongoDB
MONGODB_CONNECTION_STRING=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=microservice-portfolio

# Redis
REDIS_ENABLED=true
REDIS_HEALTH_ENABLED=false
REDIS_URL=rediss://:password@redis-prod-host:6379/0
REDIS_PASSWORD=change-me
REDIS_SSL=true
REDIS_TIMEOUT=5s
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MODE=shadow
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_KEY_SECRET=change-me-different-from-jwt-secret
GATEWAY_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
USER_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
GATEWAY_RATE_LIMIT_AUTH_PUBLIC_CAPACITY=60
GATEWAY_RATE_LIMIT_PUBLIC_READ_CAPACITY=180
GATEWAY_RATE_LIMIT_PUBLIC_WRITE_CAPACITY=30
GATEWAY_RATE_LIMIT_PUBLIC_UPLOAD_CAPACITY=10
GATEWAY_RATE_LIMIT_AUTHENTICATED_DEFAULT_IP_CAPACITY=600
GATEWAY_RATE_LIMIT_AUTHENTICATED_DEFAULT_USER_CAPACITY=300
GATEWAY_RATE_LIMIT_AUTHENTICATED_UPLOAD_IP_CAPACITY=60
GATEWAY_RATE_LIMIT_AUTHENTICATED_UPLOAD_USER_CAPACITY=20
AUTH_RATE_LIMIT_LOGIN_IP_CAPACITY=5
AUTH_RATE_LIMIT_LOGIN_EMAIL_CAPACITY=10
AUTH_RATE_LIMIT_GOOGLE_IP_CAPACITY=10
AUTH_RATE_LIMIT_REGISTER_IP_CAPACITY=5
AUTH_RATE_LIMIT_VERIFY_IP_CAPACITY=30
AUTH_RATE_LIMIT_VERIFY_EMAIL_CAPACITY=10
AUTH_RATE_LIMIT_RESEND_IP_CAPACITY=10
AUTH_RATE_LIMIT_RESEND_EMAIL_CAPACITY=3

# Auth and verification
JWT_SECRET=change-me-at-least-32-bytes
JWT_ISSUER=javanc-user-service
JWT_ACCESS_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=604800
GOOGLE_CLIENT_ID=change-me-google-client-id.apps.googleusercontent.com
GOOGLE_ISSUER=https://accounts.google.com
OTP_VERIFICATION_LENGTH=6
OTP_VERIFICATION_TTL_SECONDS=600
OTP_VERIFICATION_MAX_ATTEMPTS=5
OTP_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
OTP_HASH_SECRET=change-me-different-from-jwt-secret
USER_ADMIN_BOOTSTRAP_ENABLED=false
USER_ADMIN_EMAIL=
USER_ADMIN_PASSWORD=
USER_ADMIN_NAME=System Admin

# Image storage
IMAGE_UPLOADS_DIR=target/uploads
IMAGE_MAX_BODY_SIZE=10M
IMAGE_LOCAL_STORAGE_DIR=target/uploads/public
IMAGE_PUBLIC_BASE_URL=https://cdn.your-domain.com
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me
CLOUDINARY_FOLDER=javanc

# Mail
MAIL_HOST=smtp.provider.example
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM=no-reply@your-domain.com
MAIL_START_TLS=REQUIRED
MAIL_LOGIN=REQUIRED
MAIL_MOCK=false
MAIL_TIMEOUT_MILLIS=5000

# Messaging and async behavior
KAFKA_BOOTSTRAP_SERVERS=kafka-prod-host:9092
KAFKA_DEV_SERVICES_ENABLED=false
MESSAGING_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true
KAFKA_CONSUMER_SIDE_EFFECTS_ENABLED=true
KAFKA_DLQ_ENABLED=true
ASYNC_OTP_EMAIL_ENABLED=true
ASYNC_ROLE_NOTIFICATION_ENABLED=true
ASYNC_JOB_SIDE_EFFECTS_ENABLED=true
ASYNC_HTTP_FALLBACK_ENABLED=false
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_INTERVAL=10s
OUTBOX_MONGO_ENSURE_INDEXES=true
KAFKA_USER_EVENTS_TOPIC=javanc.user.events
KAFKA_MANAGER_EVENTS_TOPIC=javanc.manager.events
KAFKA_PROJECT_EVENTS_TOPIC=javanc.project.events
KAFKA_EMAIL_COMMANDS_TOPIC=javanc.email.commands
KAFKA_NOTIFICATION_COMMANDS_TOPIC=javanc.notification.commands
KAFKA_EMAIL_COMMANDS_DLQ_TOPIC=javanc.email.commands.dlq
KAFKA_NOTIFICATION_COMMANDS_DLQ_TOPIC=javanc.notification.commands.dlq
EMAIL_KAFKA_GROUP_ID=email-service-group
NOTIFICATION_KAFKA_GROUP_ID=notification-service-group

# Service-specific behavior
EMAIL_SERVICE_CONNECT_TIMEOUT=1000
EMAIL_SERVICE_READ_TIMEOUT=10000
ROLE_NOTIFICATIONS_ENABLED=true
MANAGER_UPLOADS_DIR=target/uploads
MANAGER_MAX_BODY_SIZE=10M
PROFILE_UPLOADS_DIR=target/uploads
PROFILE_MAX_BODY_SIZE=10M
