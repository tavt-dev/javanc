# Shared infrastructure
MYSQL_USERNAME=root
MYSQL_PASSWORD=javanc_local
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE=microservice-portfolio

# Service ports
GATEWAY_SERVICE_PORT=8080
IMAGE_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
PROFILE_SERVICE_PORT=8085
PROJECT_SERVICE_PORT=8086
EMAIL_SERVICE_PORT=8087
USER_SERVICE_PORT=8088
MANAGER_SERVICE_PORT=8091

# Service URLs for Maven-local services
USER_SERVICE_URL=http://localhost:8088
PROFILE_SERVICE_URL=http://localhost:8085
PROJECT_SERVICE_URL=http://localhost:8086
NOTIFICATION_SERVICE_URL=http://localhost:8084
MANAGER_SERVICE_URL=http://localhost:8091
IMAGE_SERVICE_URL=http://localhost:8083
EMAIL_SERVICE_URL=http://localhost:8087

# External auth
GOOGLE_CLIENT_ID=change-me-google-client-id.apps.googleusercontent.com
GOOGLE_ISSUER=https://accounts.google.com

# MySQL-backed services
USER_MYSQL_JDBC_URL=jdbc:mysql://localhost:3306/portfolio?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
PROJECT_MYSQL_JDBC_URL=jdbc:mysql://localhost:3306/project1?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&useLegacyDatetimeCode=false&allowPublicKeyRetrieval=true
NOTIFICATION_MYSQL_JDBC_URL=jdbc:mysql://localhost:3306/notification1?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&useLegacyDatetimeCode=false&allowPublicKeyRetrieval=true
IMAGE_MYSQL_JDBC_URL=jdbc:mysql://localhost:3306/image?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
EMAIL_MYSQL_JDBC_URL=jdbc:mysql://localhost:3306/email?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Local mail mock
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=dev@javanc.local
MAIL_START_TLS=DISABLED
MAIL_LOGIN=DISABLED
MAIL_MOCK=false

# Kafka-enabled local runtime for services running on the host.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_DEV_SERVICES_ENABLED=false
MESSAGING_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true
ASYNC_OTP_EMAIL_ENABLED=true
ASYNC_ROLE_NOTIFICATION_ENABLED=true
ASYNC_JOB_SIDE_EFFECTS_ENABLED=true
ASYNC_HTTP_FALLBACK_ENABLED=false
KAFKA_CONSUMER_SIDE_EFFECTS_ENABLED=true
KAFKA_DLQ_ENABLED=true
