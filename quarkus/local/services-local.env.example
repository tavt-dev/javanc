# Shared infrastructure
MYSQL_USERNAME=root
MYSQL_PASSWORD=javanc_local
MONGODB_CONNECTION_STRING=mongodb://root:javanc_local@localhost:27017/?authSource=admin
MONGODB_DATABASE=microservice-portfolio
LOG_JSON_ENABLED=false
METRICS_PROMETHEUS_ENABLED=true
DOWNSTREAM_CONNECT_TIMEOUT=1000
DOWNSTREAM_READ_TIMEOUT=3000
REDIS_ENABLED=true
REDIS_HEALTH_ENABLED=false
REDIS_URL=redis://:javanc_local@localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MODE=shadow
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_KEY_SECRET=change-me-rate-limit-secret
GATEWAY_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
USER_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=javanc_local
REDIS_DATABASE=0
REDIS_SSL=false
REDIS_TIMEOUT=5s

# Service ports
GATEWAY_SERVICE_PORT=8080
IMAGE_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
PROFILE_SERVICE_PORT=8085
PROJECT_SERVICE_PORT=8086
EMAIL_SERVICE_PORT=8087
USER_SERVICE_PORT=8088
MANAGER_SERVICE_PORT=8091

# Service URLs for Maven-local services
USER_SERVICE_URL=http://localhost:8088
PROFILE_SERVICE_URL=http://localhost:8085
PROJECT_SERVICE_URL=http://localhost:8086
NOTIFICATION_SERVICE_URL=http://localhost:8084
MANAGER_SERVICE_URL=http://localhost:8091
IMAGE_SERVICE_URL=http://localhost:8083
EMAIL_SERVICE_URL=http://localhost:8087
GATEWAY_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000,http://127.0.0.1:3000

# External auth
JWT_SECRET=change-me-local-dev-secret-at-least-32-bytes
GOOGLE_CLIENT_ID=change-me-google-client-id.apps.googleusercontent.com
GOOGLE_ISSUER=https://accounts.google.com
OTP_HASH_SECRET=change-me-local-dev-otp-secret-at-least-32-bytes

# MySQL-backed services
USER_MYSQL_JDBC_URL=jdbc:mysql://localhost:3307/portfolio?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
PROJECT_MYSQL_JDBC_URL=jdbc:mysql://localhost:3307/project1?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&useLegacyDatetimeCode=false&allowPublicKeyRetrieval=true
NOTIFICATION_MYSQL_JDBC_URL=jdbc:mysql://localhost:3307/notification1?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&useLegacyDatetimeCode=false&allowPublicKeyRetrieval=true
IMAGE_MYSQL_JDBC_URL=jdbc:mysql://localhost:3307/image?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
EMAIL_MYSQL_JDBC_URL=jdbc:mysql://localhost:3307/email?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
USER_DB_SCHEMA_STRATEGY=validate
USER_DB_BASELINE_ON_MIGRATE=true
PROJECT_DB_GENERATION=update
NOTIFICATION_DB_GENERATION=update
IMAGE_DB_GENERATION=update
EMAIL_DB_SCHEMA_STRATEGY=validate
EMAIL_DB_BASELINE_ON_MIGRATE=true

# Image service local storage
IMAGE_LOCAL_STORAGE_DIR=target/uploads/public
IMAGE_PUBLIC_BASE_URL=http://localhost:8083

# Local mail mock
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=dev@javanc.local
MAIL_START_TLS=DISABLED
MAIL_LOGIN=DISABLED
MAIL_MOCK=false

# Baseline local runtime. Keep Kafka business flow off by default.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_DEV_SERVICES_ENABLED=false
MESSAGING_ENABLED=false
OUTBOX_PUBLISHER_ENABLED=false
ASYNC_OTP_EMAIL_ENABLED=false
ASYNC_ROLE_NOTIFICATION_ENABLED=false
ASYNC_JOB_SIDE_EFFECTS_ENABLED=false
ASYNC_HTTP_FALLBACK_ENABLED=true
KAFKA_CONSUMER_SIDE_EFFECTS_ENABLED=false
KAFKA_DLQ_ENABLED=false

# User-service delivery and notification behavior
EMAIL_SERVICE_CONNECT_TIMEOUT=1000
EMAIL_SERVICE_READ_TIMEOUT=10000
ROLE_NOTIFICATIONS_ENABLED=true
